+  t.magFilter = THREE.NearestFilter;      // ★ 像素感（不做模糊）
+  t.minFilter = THREE.NearestFilter;
+  t.colorSpace = THREE.SRGBColorSpace;
+  return t;
+}
+
+// 六面材質：[+x, -x, +y, -y, +z(正面), -z]
+function mcMats(frontMap, sideColor, topColor, bottomColor) {
