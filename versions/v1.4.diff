+// 🧤 撲救：身體撲出去時的「呼——」風聲
+export function diveWhoosh() {
+  if (!ctx) return;
+  const t0 = ctx.currentTime + 0.01;
+  try {
+    noise(t0, { dur: 0.34, gain: 0.18, type: 'bandpass', freq: 500, q: 0.8, sweepTo: 2200 });
+    tone(t0, { type: 'sine', f0: 160, f1: 90, dur: 0.22, gain: 0.1 });
+  } catch (e) {}
+}
+
+// 🧤 撲到球：手套「啪」一聲
+export function catchThud() {
